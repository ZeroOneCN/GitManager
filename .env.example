# GitManager 运行配置示例：复制为 .env 后按需修改。
# 服务监听地址：默认仅本机回环；改为 0.0.0.0 可局域网访问（必须同时配置令牌与允许的 Host）。
GITMANAGER_HOST=127.0.0.1
GITMANAGER_PORT=8765

# 局域网访问令牌：留空时，非回环监听会在首次启动自动生成强随机令牌并写回本文件
GITMANAGER_ACCESS_TOKEN=

# 允许的 Host 头（分号分隔，防 DNS rebinding）：局域网访问必须显式加入本机局域网 IP/主机名
GITMANAGER_ALLOWED_HOSTS=127.0.0.1;localhost

# 系统 git 可执行文件绝对路径
GIT_EXECUTABLE=D:\CodeDevelop\Env\Git\cmd\git.exe

# SQLite 数据库文件（相对路径按项目根目录解析）
GITMANAGER_DB=data/gitmanager.db

# 仓库白名单根目录：分号分隔；添加的仓库必须位于这些目录内
GITMANAGER_ALLOWED_ROOTS=E:\Code

# 操作审计保留天数（启动时清理超期记录）
GITMANAGER_LOG_RETENTION_DAYS=90

# pull 是否默认自动 stash（安全默认：关闭，必须由前端显式勾选）
PULL_AUTO_STASH_DEFAULT=false

# 单次 git 子进程超时（秒）
GIT_OPERATION_TIMEOUT_SECONDS=120

# 仓库扫描：最大深度（根目录为 0）与结果条数上限
GITMANAGER_SCAN_MAX_DEPTH=6
GITMANAGER_SCAN_RESULT_LIMIT=200
# 可选：自定义噪音目录（分号分隔）；留空使用内置默认值
GITMANAGER_SCAN_NOISE_DIRS=node_modules;.venv;venv;dist;build;target;bin;obj;__pycache__;.git

# SSH 身份：扫描目录、ssh/ssh-keygen 路径与连接测试超时
SSH_DIR=%USERPROFILE%\.ssh
SSH_EXECUTABLE=D:\CodeDevelop\Env\Git\usr\bin\ssh.exe
SSH_KEYGEN_EXECUTABLE=D:\CodeDevelop\Env\Git\usr\bin\ssh-keygen.exe
SSH_TEST_TIMEOUT_SECONDS=10

# GitManager 运行配置示例：复制为 .env 后按需修改。
# 服务监听地址：仅允许回环地址（127.0.0.1 / localhost），其他值会拒绝启动。
APP_HOST=127.0.0.1
APP_PORT=8765

# 系统 git 可执行文件绝对路径
GIT_EXECUTABLE=D:\CodeDevelop\Env\Git\cmd\git.exe

# SQLite 数据库文件（相对路径按项目根目录解析）
GITMANAGER_DB=data/gitmanager.db

# 仓库白名单根目录：分号分隔；添加的仓库必须位于这些目录内
GITMANAGER_ALLOWED_ROOTS=E:\Code

# 操作审计保留天数（启动时清理超期记录）
GITMANAGER_LOG_RETENTION_DAYS=90

# pull 是否默认自动 stash（安全默认：关闭，必须由前端显式勾选）
PULL_AUTO_STASH_DEFAULT=false

# 单次 git 子进程超时（秒）
GIT_OPERATION_TIMEOUT_SECONDS=120
